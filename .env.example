AEGIS_DB_PATH=./aegis.db
AEGIS_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret
AEGIS_COOKIE_SECURE=true
AEGIS_ALLOWED_ORIGINS=http://localhost:8000
AEGIS_WORKER_IMAGE=
AEGIS_EVM_RPC_URLS={}
AEGIS_STELLAR_RPC_URL=
# Optional full catalog override; these are development limits, not commercial promises.
# AEGIS_PLAN_LIMITS={"free":{"audits":5,"ai_reviews":5,"agent_runs":10,"conversation_messages":100,"conversation_creations":20},"pro":{"audits":50,"ai_reviews":50,"agent_runs":100,"conversation_messages":500,"conversation_creations":100},"enterprise":{"audits":200,"ai_reviews":200,"agent_runs":500,"conversation_messages":2000,"conversation_creations":500}}
AEGIS_AI_PROVIDER=openai
AEGIS_AI_API_KEY=
AEGIS_AI_MODEL=
# Optional HTTPS endpoint override for OpenAI only; never accepted from clients.
AEGIS_AI_API_URL=https://api.openai.com/v1/chat/completions
